# Copy to .env.local. Never commit .env.local.

# Use postgres after starting the local services with Docker Compose.
# Set DATA_SOURCE=mock if you only want the in-memory UI demo.
DATA_SOURCE=postgres

# Used when DATA_SOURCE=postgres. civic_app is the login role from 007_rbac_rls.sql:
# it has no table rights of its own and switches role per request.
DATABASE_URL=postgres://civic_app:civicfix-app-local@localhost:5432/civicfix
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
