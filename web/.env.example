# Copy to .env.local. Never commit .env.local.

# mock (default): in-memory demo data, no database needed
# postgres: PostgreSQL + Qdrant (see ../db/README.md)
DATA_SOURCE=mock

# Used when DATA_SOURCE=postgres
DATABASE_URL=postgres://civic_app:change-me@localhost:5432/civicfix
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
