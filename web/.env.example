# Copy to .env.local. Never commit .env.local.

# Use postgres after starting the local services with Docker Compose.
# Set DATA_SOURCE=mock if you only want the in-memory UI demo.
DATA_SOURCE=postgres

# Used when DATA_SOURCE=postgres
DATABASE_URL=postgres://postgres:civicfix-local@localhost:5432/civicfix
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
